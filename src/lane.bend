# The even bits of x in its low half, the odd bits in its high half.
def unz(+x: U32) -> U32:
  U32.or(U32.or(ub0(U32.to_nat(U32.and(255,x))),ub1(U32.to_nat(U32.and(255,U32.shrn(x,8n))))),U32.or(ub2(U32.to_nat(U32.and(255,U32.shrn(x,16n)))),ub3(U32.to_nat(U32.shrn(x,24n)))))

# unz's inverse.
def zip(+x: U32) -> U32:
  swap1(swap2(swap4(swap8(x))))

# The even and the odd bits of a lane, from the unz of its low and high words.
def even(+ul: U32, +uh: U32) -> U32:
  U32.or(U32.and(65535,ul),U32.shln(uh,16n))

def odd(+ul: U32, +uh: U32) -> U32:
  U32.or(U32.shrn(ul,16n),U32.and(4294901760,uh))

# The low and the high word of the lane with even bits e, odd bits o.
def low(+e: U32, +o: U32) -> U32:
  zip(U32.or(U32.and(65535,e),U32.shln(o,16n)))

def high(+e: U32, +o: U32) -> U32:
  zip(U32.or(U32.shrn(e,16n),U32.and(4294901760,o)))

# A plain state in the interleaved representation.
def enter(s: T.State) -> T.St:
  match s:
    case T.S{T.W{+x0,+y0},T.W{+x1,+y1},T.W{+x2,+y2},T.W{+x3,+y3},T.W{+x4,+y4},T.W{+x5,+y5},T.W{+x6,+y6},T.W{+x7,+y7},T.W{+x8,+y8},T.W{+x9,+y9},T.W{+x10,+y10},T.W{+x11,+y11},T.W{+x12,+y12},T.W{+x13,+y13},T.W{+x14,+y14},T.W{+x15,+y15},T.W{+x16,+y16},T.W{+x17,+y17},T.W{+x18,+y18},T.W{+x19,+y19},T.W{+x20,+y20},T.W{+x21,+y21},T.W{+x22,+y22},T.W{+x23,+y23},T.W{+x24,+y24}}:
      T.St{even(unz(x0),unz(y0)),odd(unz(x0),unz(y0)),U32.not(even(unz(x1),unz(y1))),U32.not(odd(unz(x1),unz(y1))),U32.not(even(unz(x2),unz(y2))),U32.not(odd(unz(x2),unz(y2))),even(unz(x3),unz(y3)),odd(unz(x3),unz(y3)),even(unz(x4),unz(y4)),odd(unz(x4),unz(y4)),even(unz(x5),unz(y5)),odd(unz(x5),unz(y5)),even(unz(x6),unz(y6)),odd(unz(x6),unz(y6)),even(unz(x7),unz(y7)),odd(unz(x7),unz(y7)),U32.not(even(unz(x8),unz(y8))),U32.not(odd(unz(x8),unz(y8))),even(unz(x9),unz(y9)),odd(unz(x9),unz(y9)),even(unz(x10),unz(y10)),odd(unz(x10),unz(y10)),even(unz(x11),unz(y11)),odd(unz(x11),unz(y11)),U32.not(even(unz(x12),unz(y12))),U32.not(odd(unz(x12),unz(y12))),even(unz(x13),unz(y13)),odd(unz(x13),unz(y13)),even(unz(x14),unz(y14)),odd(unz(x14),unz(y14)),even(unz(x15),unz(y15)),odd(unz(x15),unz(y15)),even(unz(x16),unz(y16)),odd(unz(x16),unz(y16)),U32.not(even(unz(x17),unz(y17))),U32.not(odd(unz(x17),unz(y17))),even(unz(x18),unz(y18)),odd(unz(x18),unz(y18)),even(unz(x19),unz(y19)),odd(unz(x19),unz(y19)),U32.not(even(unz(x20),unz(y20))),U32.not(odd(unz(x20),unz(y20))),even(unz(x21),unz(y21)),odd(unz(x21),unz(y21)),even(unz(x22),unz(y22)),odd(unz(x22),unz(y22)),even(unz(x23),unz(y23)),odd(unz(x23),unz(y23)),even(unz(x24),unz(y24)),odd(unz(x24),unz(y24))}

# enter's inverse.
def leave(s: T.St) -> T.State:
  match s:
    case T.St{+e0,+o0,+e1,+o1,+e2,+o2,+e3,+o3,+e4,+o4,+e5,+o5,+e6,+o6,+e7,+o7,+e8,+o8,+e9,+o9,+e10,+o10,+e11,+o11,+e12,+o12,+e13,+o13,+e14,+o14,+e15,+o15,+e16,+o16,+e17,+o17,+e18,+o18,+e19,+o19,+e20,+o20,+e21,+o21,+e22,+o22,+e23,+o23,+e24,+o24}:
      T.S{T.W{low(e0,o0),high(e0,o0)},T.W{low(U32.not(e1),U32.not(o1)),high(U32.not(e1),U32.not(o1))},T.W{low(U32.not(e2),U32.not(o2)),high(U32.not(e2),U32.not(o2))},T.W{low(e3,o3),high(e3,o3)},T.W{low(e4,o4),high(e4,o4)},T.W{low(e5,o5),high(e5,o5)},T.W{low(e6,o6),high(e6,o6)},T.W{low(e7,o7),high(e7,o7)},T.W{low(U32.not(e8),U32.not(o8)),high(U32.not(e8),U32.not(o8))},T.W{low(e9,o9),high(e9,o9)},T.W{low(e10,o10),high(e10,o10)},T.W{low(e11,o11),high(e11,o11)},T.W{low(U32.not(e12),U32.not(o12)),high(U32.not(e12),U32.not(o12))},T.W{low(e13,o13),high(e13,o13)},T.W{low(e14,o14),high(e14,o14)},T.W{low(e15,o15),high(e15,o15)},T.W{low(e16,o16),high(e16,o16)},T.W{low(U32.not(e17),U32.not(o17)),high(U32.not(e17),U32.not(o17))},T.W{low(e18,o18),high(e18,o18)},T.W{low(e19,o19),high(e19,o19)},T.W{low(U32.not(e20),U32.not(o20)),high(U32.not(e20),U32.not(o20))},T.W{low(e21,o21),high(e21,o21)},T.W{low(e22,o22),high(e22,o22)},T.W{low(e23,o23),high(e23,o23)},T.W{low(e24,o24),high(e24,o24)}}

# A block's 34 words XORed into the first 17 lanes.
def mix(s: T.St,w0: U32,w1: U32,w2: U32,w3: U32,w4: U32,w5: U32,w6: U32,w7: U32,w8: U32,w9: U32,w10: U32,w11: U32,w12: U32,w13: U32,w14: U32,w15: U32,w16: U32,w17: U32,w18: U32,w19: U32,w20: U32,w21: U32,w22: U32,w23: U32,w24: U32,w25: U32,w26: U32,w27: U32,w28: U32,w29: U32,w30: U32,w31: U32,w32: U32,w33: U32) -> T.St:
  match s:
    case T.St{+e0,+o0,+e1,+o1,+e2,+o2,+e3,+o3,+e4,+o4,+e5,+o5,+e6,+o6,+e7,+o7,+e8,+o8,+e9,+o9,+e10,+o10,+e11,+o11,+e12,+o12,+e13,+o13,+e14,+o14,+e15,+o15,+e16,+o16,+e17,+o17,+e18,+o18,+e19,+o19,+e20,+o20,+e21,+o21,+e22,+o22,+e23,+o23,+e24,+o24}:
      +l0 = unz(w0)
      +h0 = unz(w1)
      +l1 = unz(w2)
      +h1 = unz(w3)
      +l2 = unz(w4)
      +h2 = unz(w5)
      +l3 = unz(w6)
      +h3 = unz(w7)
      +l4 = unz(w8)
      +h4 = unz(w9)
      +l5 = unz(w10)
      +h5 = unz(w11)
      +l6 = unz(w12)
      +h6 = unz(w13)
      +l7 = unz(w14)
      +h7 = unz(w15)
      +l8 = unz(w16)
      +h8 = unz(w17)
      +l9 = unz(w18)
      +h9 = unz(w19)
      +l10 = unz(w20)
      +h10 = unz(w21)
      +l11 = unz(w22)
      +h11 = unz(w23)
      +l12 = unz(w24)
      +h12 = unz(w25)
      +l13 = unz(w26)
      +h13 = unz(w27)
      +l14 = unz(w28)
      +h14 = unz(w29)
      +l15 = unz(w30)
      +h15 = unz(w31)
      +l16 = unz(w32)
      +h16 = unz(w33)
      T.St{U32.xor(e0,even(l0,h0)),U32.xor(o0,odd(l0,h0)),U32.xor(e1,even(l1,h1)),U32.xor(o1,odd(l1,h1)),U32.xor(e2,even(l2,h2)),U32.xor(o2,odd(l2,h2)),U32.xor(e3,even(l3,h3)),U32.xor(o3,odd(l3,h3)),U32.xor(e4,even(l4,h4)),U32.xor(o4,odd(l4,h4)),U32.xor(e5,even(l5,h5)),U32.xor(o5,odd(l5,h5)),U32.xor(e6,even(l6,h6)),U32.xor(o6,odd(l6,h6)),U32.xor(e7,even(l7,h7)),U32.xor(o7,odd(l7,h7)),U32.xor(e8,even(l8,h8)),U32.xor(o8,odd(l8,h8)),U32.xor(e9,even(l9,h9)),U32.xor(o9,odd(l9,h9)),U32.xor(e10,even(l10,h10)),U32.xor(o10,odd(l10,h10)),U32.xor(e11,even(l11,h11)),U32.xor(o11,odd(l11,h11)),U32.xor(e12,even(l12,h12)),U32.xor(o12,odd(l12,h12)),U32.xor(e13,even(l13,h13)),U32.xor(o13,odd(l13,h13)),U32.xor(e14,even(l14,h14)),U32.xor(o14,odd(l14,h14)),U32.xor(e15,even(l15,h15)),U32.xor(o15,odd(l15,h15)),U32.xor(e16,even(l16,h16)),U32.xor(o16,odd(l16,h16)),e17,o17,e18,o18,e19,o19,e20,o20,e21,o21,e22,o22,e23,o23,e24,o24}

# The first four lanes as plain lanes, the rest zero: all the digest reads.
def squeeze(s: T.St) -> T.State:
  match s:
    case T.St{+e0,+o0,+e1,+o1,+e2,+o2,+e3,+o3,+e4,+o4,+e5,+o5,+e6,+o6,+e7,+o7,+e8,+o8,+e9,+o9,+e10,+o10,+e11,+o11,+e12,+o12,+e13,+o13,+e14,+o14,+e15,+o15,+e16,+o16,+e17,+o17,+e18,+o18,+e19,+o19,+e20,+o20,+e21,+o21,+e22,+o22,+e23,+o23,+e24,+o24}:
      T.S{T.W{low(e0,o0),high(e0,o0)},T.W{low(U32.not(e1),U32.not(o1)),high(U32.not(e1),U32.not(o1))},T.W{low(U32.not(e2),U32.not(o2)),high(U32.not(e2),U32.not(o2))},T.W{low(e3,o3),high(e3,o3)},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0}}
