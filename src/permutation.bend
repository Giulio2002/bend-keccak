      +b22er1 = U32.or(U32.shln(U32.xor(q14or0,d4or1),20n),U32.shrn(U32.xor(q14or0,d4or1),12n))
      +b22or1 = U32.or(U32.shln(U32.xor(q14er0,d4er1),19n),U32.shrn(U32.xor(q14er0,d4er1),13n))
      +b23er1 = U32.or(U32.shln(U32.xor(q15or0,d0or1),21n),U32.shrn(U32.xor(q15or0,d0or1),11n))
      +b23or1 = U32.or(U32.shln(U32.xor(q15er0,d0er1),20n),U32.shrn(U32.xor(q15er0,d0er1),12n))
