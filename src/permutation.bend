      +b19or1 = U32.or(U32.shln(U32.xor(q23or0,d3or1),28n),U32.shrn(U32.xor(q23or0,d3or1),4n))
      +q15er1 = U32.xor(b15er1,U32.and(b16er1,b17er1))
      +q15or1 = U32.xor(b15or1,U32.and(b16or1,b17or1))
      +q16er1 = U32.xor(b16er1,U32.or(b17er1,b18er1))
      +q16or1 = U32.xor(b16or1,U32.or(b17or1,b18or1))
      +q17er1 = U32.xor(b17er1,U32.or(U32.not(b18er1),b19er1))
      +q17or1 = U32.xor(b17or1,U32.or(U32.not(b18or1),b19or1))
      +q18er1 = U32.xor(U32.not(b18er1),U32.and(b19er1,b15er1))
      +q18or1 = U32.xor(U32.not(b18or1),U32.and(b19or1,b15or1))
      +q19er1 = U32.xor(b19er1,U32.or(b15er1,b16er1))
      +q19or1 = U32.xor(b19or1,U32.or(b15or1,b16or1))
      +b20er1 = U32.or(U32.shln(U32.xor(q2er0,d2er1),31n),U32.shrn(U32.xor(q2er0,d2er1),1n))
      +b20or1 = U32.or(U32.shln(U32.xor(q2or0,d2or1),31n),U32.shrn(U32.xor(q2or0,d2or1),1n))
      +b21er1 = U32.or(U32.shln(U32.xor(q8or0,d3or1),28n),U32.shrn(U32.xor(q8or0,d3or1),4n))
