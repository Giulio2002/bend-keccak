law blocks_step:
  for +r: Nat
  for +n: Nat
  for +index: U32
  for +remain: Nat
  for -a: Array<U32>
  for +s: T.State
  for view: Sigma<&2,&1,A.Tree,t => {a == A.thaw(t) : Array<U32>}>
  for recurse: @pair: (Array<U32> & T.State) -> {K.blocks(r,n,U32.add(index,34),remain,lift(pair)) == I.interleave(R.blocks(r,n,U32.add(index,34),remain,pair)) : T.St}
  {K.blocks(r,1n+n,index,remain,lift((a,s))) == I.interleave(R.blocks(r,1n+n,index,remain,(a,s))) : T.St}

def blocks_step(r,n,index,remain,a,s,view,recurse):
  match view:
    case Tuple{+tree,pf}:
      %Equal.sym(Array<U32>,a,A.thaw(tree),pf) : {K.blocks(r,1n+n,index,remain,lift((_,s))) == I.interleave(R.blocks(r,1n+n,index,remain,(_,s))) : T.St}
      Equal.trans(T.St,
        K.blocks(r,n,U32.add(index,34),remain,K.absorb(r,A.thaw(tree),index,I.interleave(s))),
        K.blocks(r,n,U32.add(index,34),remain,lift(R.absorb(r,A.thaw(tree),index,s))),
        I.interleave(R.blocks(r,n,U32.add(index,34),remain,R.absorb(r,A.thaw(tree),index,s))),
        Equal.cong(Array<U32> & T.St,T.St,p => K.blocks(r,n,U32.add(index,34),remain,p),
          K.absorb(r,A.thaw(tree),index,I.interleave(s)),lift(R.absorb(r,A.thaw(tree),index,s)),absorb_correct(r,A.thaw(tree),index,s)),
        recurse(R.absorb(r,A.thaw(tree),index,s)))

law blocks_correct:
  for +r: Nat
  for +n: Nat
  for +index: U32
  for +remain: Nat
  for pair: Array<U32> & T.State
  {K.blocks(r,n,index,remain,lift(pair)) == I.interleave(R.blocks(r,n,index,remain,pair)) : T.St}

def blocks_correct(r,n,index,remain,pair):
  match n pair:
    case 0n Tuple{a,s}: finish_correct(r,a,index,remain,s)
    case 1n+p Tuple{a,s}:
      blocks_step(r,p,index,remain,a,s,A.reify(a),pair => blocks_correct(r,p,U32.add(index,34),remain,pair))

law unchecked_correct:
  for +r: Nat
  for a: Array<U32>
  for +length: Nat
  {K.unchecked(r,a,length) == I.interleave(R.unchecked(r,a,length)) : T.St}

def unchecked_correct(r,a,length):
  blocks_correct(r,Nat.div(length,136n),0,Nat.mod(length,136n),(a,R.initial()))

def dig(+v0: U32, +v1: U32, +v2: U32, +v3: U32, +v4: U32, +v5: U32, +v6: U32, +v7: U32) -> Array<U32>:
  K.digest(T.S{T.W{v0,v1},T.W{v2,v3},T.W{v4,v5},T.W{v6,v7},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0},T.W{0,0}})

law dig_cong:
  for -x0: U32
  for -y0: U32
  for -x1: U32
  for -y1: U32
  for -x2: U32
  for -y2: U32
  for -x3: U32
  for -y3: U32
  for -x4: U32
  for -y4: U32
  for -x5: U32
  for -y5: U32
  for -x6: U32
  for -y6: U32
  for -x7: U32
  for -y7: U32
  for e0: {x0 == y0 : U32}
  for e1: {x1 == y1 : U32}
  for e2: {x2 == y2 : U32}
  for e3: {x3 == y3 : U32}
  for e4: {x4 == y4 : U32}
  for e5: {x5 == y5 : U32}
  for e6: {x6 == y6 : U32}
  for e7: {x7 == y7 : U32}
  {dig(x0,x1,x2,x3,x4,x5,x6,x7) == dig(y0,y1,y2,y3,y4,y5,y6,y7) : Array<U32>}

def dig_cong(x0,y0,x1,y1,x2,y2,x3,y3,x4,y4,x5,y5,x6,y6,x7,y7,e0,e1,e2,e3,e4,e5,e6,e7):
  %e0 : {dig(x0,x1,x2,x3,x4,x5,x6,x7) == dig(_,y1,y2,y3,y4,y5,y6,y7) : Array<U32>}
  %e1 : {dig(x0,x1,x2,x3,x4,x5,x6,x7) == dig(x0,_,y2,y3,y4,y5,y6,y7) : Array<U32>}
  %e2 : {dig(x0,x1,x2,x3,x4,x5,x6,x7) == dig(x0,x1,_,y3,y4,y5,y6,y7) : Array<U32>}
  %e3 : {dig(x0,x1,x2,x3,x4,x5,x6,x7) == dig(x0,x1,x2,_,y4,y5,y6,y7) : Array<U32>}
  %e4 : {dig(x0,x1,x2,x3,x4,x5,x6,x7) == dig(x0,x1,x2,x3,_,y5,y6,y7) : Array<U32>}
  %e5 : {dig(x0,x1,x2,x3,x4,x5,x6,x7) == dig(x0,x1,x2,x3,x4,_,y6,y7) : Array<U32>}
  %e6 : {dig(x0,x1,x2,x3,x4,x5,x6,x7) == dig(x0,x1,x2,x3,x4,x5,_,y7) : Array<U32>}
  %e7 : {dig(x0,x1,x2,x3,x4,x5,x6,x7) == dig(x0,x1,x2,x3,x4,x5,x6,_) : Array<U32>}
  {==}

law squeeze_correct:
  for +s: T.State
  {K.digest(L.squeeze(I.interleave(s))) == K.digest(s) : Array<U32>}

def squeeze_correct(s):
  match s:
    case T.S{T.W{+x0,+y0},T.W{+x1,+y1},T.W{+x2,+y2},T.W{+x3,+y3},a4,a5,a6,a7,a8,a9,a10,a11,a12,a13,a14,a15,a16,a17,a18,a19,a20,a21,a22,a23,a24}:
      dig_cong(L.low(I.even(T.W{x0,y0}),I.odd(T.W{x0,y0})),x0,L.high(I.even(T.W{x0,y0}),I.odd(T.W{x0,y0})),y0,L.low(U32.not(U32.not(I.even(T.W{x1,y1}))),U32.not(U32.not(I.odd(T.W{x1,y1})))),x1,L.high(U32.not(U32.not(I.even(T.W{x1,y1}))),U32.not(U32.not(I.odd(T.W{x1,y1})))),y1,L.low(U32.not(U32.not(I.even(T.W{x2,y2}))),U32.not(U32.not(I.odd(T.W{x2,y2})))),x2,L.high(U32.not(U32.not(I.even(T.W{x2,y2}))),U32.not(U32.not(I.odd(T.W{x2,y2})))),y2,L.low(I.even(T.W{x3,y3}),I.odd(T.W{x3,y3})),x3,L.high(I.even(T.W{x3,y3}),I.odd(T.W{x3,y3})),y3,Q.low_il(x0,y0),Q.high_il(x0,y0),Q.lowc_il(x1,y1),Q.highc_il(x1,y1),Q.lowc_il(x2,y2),Q.highc_il(x2,y2),Q.low_il(x3,y3),Q.high_il(x3,y3))

law digest_correct:
  for +s: T.State
  {K.digest(s) == R.digest(s) : Array<U32>}

def digest_correct(s):
  match s:
    case T.S{T.W{a0,b0},T.W{a1,b1},T.W{a2,b2},T.W{a3,b3},a4,a5,a6,a7,a8,a9,a10,a11,a12,a13,a14,a15,a16,a17,a18,a19,a20,a21,a22,a23,a24}: {==}

law checked_true_reified:
  for +r: Nat
  for -a: Array<U32>
  for +length: Nat
  for view: Sigma<&2,&1,A.Tree,t => {a == A.thaw(t) : Array<U32>}>
  {K.checked(r,True{},a,length) == R.checked(r,True{},a,length) : Maybe<&1,Array<U32>>}

def checked_true_reified(r,a,length,view):
  match view:
    case Tuple{+tree,pf}:
      %Equal.sym(Array<U32>,a,A.thaw(tree),pf) : {K.checked(r,True{},_,length) == R.checked(r,True{},_,length) : Maybe<&1,Array<U32>>}
      Equal.trans(Maybe<&1,Array<U32>>,
        Some{K.digest(L.squeeze(K.unchecked(r,A.thaw(tree),length)))},
        Some{K.digest(L.squeeze(I.interleave(R.unchecked(r,A.thaw(tree),length))))},
        Some{R.digest(R.unchecked(r,A.thaw(tree),length))},
        Equal.cong(T.St,Maybe<&1,Array<U32>>,t => Some{K.digest(L.squeeze(t))},K.unchecked(r,A.thaw(tree),length),I.interleave(R.unchecked(r,A.thaw(tree),length)),unchecked_correct(r,A.thaw(tree),length)),
      Equal.trans(Maybe<&1,Array<U32>>,
        Some{K.digest(L.squeeze(I.interleave(R.unchecked(r,A.thaw(tree),length))))},
        Some{K.digest(R.unchecked(r,A.thaw(tree),length))},
        Some{R.digest(R.unchecked(r,A.thaw(tree),length))},
        Equal.cong(Array<U32>,Maybe<&1,Array<U32>>,d => Some{d},K.digest(L.squeeze(I.interleave(R.unchecked(r,A.thaw(tree),length)))),K.digest(R.unchecked(r,A.thaw(tree),length)),squeeze_correct(R.unchecked(r,A.thaw(tree),length))),
        Equal.cong(Array<U32>,Maybe<&1,Array<U32>>,d => Some{d},K.digest(R.unchecked(r,A.thaw(tree),length)),R.digest(R.unchecked(r,A.thaw(tree),length)),digest_correct(R.unchecked(r,A.thaw(tree),length)))))

law checked_correct:
  for +r: Nat
  for +valid: Bool
  for a: Array<U32>
  for +length: Nat
  {K.checked(r,valid,a,length) == R.checked(r,valid,a,length) : Maybe<&1,Array<U32>>}

def checked_correct(r,valid,a,length):
  match valid:
    case False{}: {==}
    case True{}: checked_true_reified(r,a,length,A.reify(a))

law sized_correct:
  for +r: Nat
  for +length: Nat
  for pair: Array<U32> & U32
  {K.sized(r,length,pair) == R.sized(r,length,pair) : Maybe<&1,Array<U32>>}

def sized_correct(r,length,pair):
  (a,capacity) = pair
  checked_correct(r,Nat.is_le(length,Nat.mul(4n,U32.to_nat(capacity))),a,length)

law hash_correct:
  for +r: Nat
  for a: Array<U32>
  for +length: Nat
  {K.keccak256_rounds(r,a,length) == R.keccak256_rounds(r,a,length) : Maybe<&1,Array<U32>>}

def hash_correct(r,a,length):
  sized_correct(r,length,Array.size(U32,a))

law ethereum_round_count:
  for a: Array<U32>
  for +length: Nat
  {K.keccak256(a,length) == K.keccak256_rounds(24n,a,length) : Maybe<&1,Array<U32>>}

def ethereum_round_count(a,length): {==}

law public_correct:
  for a: Array<U32>
  for +length: Nat
  {K.keccak256(a,length) == R.keccak256_rounds(24n,a,length) : Maybe<&1,Array<U32>>}

def public_correct(a,length): hash_correct(24n,a,length)
