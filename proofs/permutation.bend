# Theta/rho expressions: input lanes, the round constant, XOR, rotation.
type Ex is Data:
  V{n: Nat}
  C{}
  X{a: Ex, b: Ex}
  R{n: Nat, a: Ex}

def sv(+s: T.State, +rc: T.Lane, e: Ex) -> T.Lane:
  match e:
    case V{n}: F.at(s,n)
    case C{}: rc
    case X{a,b}: F.xor(sv(s,rc,a),sv(s,rc,b))
    case R{n,a}: rol(n,sv(s,rc,a))

