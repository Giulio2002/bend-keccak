law or4_cong:
  for -a0: U32
  for -b0: U32
  for -a1: U32
  for -b1: U32
  for -a2: U32
  for -b2: U32
  for -a3: U32
  for -b3: U32
  for e0: {a0 == b0 : U32}
  for e1: {a1 == b1 : U32}
  for e2: {a2 == b2 : U32}
  for e3: {a3 == b3 : U32}
  {U32.or(U32.or(a0,a1),U32.or(a2,a3)) == U32.or(U32.or(b0,b1),U32.or(b2,b3)) : U32}

def or4_cong(a0,b0,a1,b1,a2,b2,a3,b3,e0,e1,e2,e3):
  %e0 : {U32.or(U32.or(a0,a1),U32.or(a2,a3)) == U32.or(U32.or(_,b1),U32.or(b2,b3)) : U32}
  %e1 : {U32.or(U32.or(a0,a1),U32.or(a2,a3)) == U32.or(U32.or(a0,_),U32.or(b2,b3)) : U32}
  %e2 : {U32.or(U32.or(a0,a1),U32.or(a2,a3)) == U32.or(U32.or(a0,a1),U32.or(_,b3)) : U32}
  %e3 : {U32.or(U32.or(a0,a1),U32.or(a2,a3)) == U32.or(U32.or(a0,a1),U32.or(a2,_)) : U32}
  {==}

law punz_parts:
  for +x: U32
  {U32.or(U32.or(pbyte0(x),pbyte1(x)),U32.or(pbyte2(x),pbyte3(x))) == punz(x) : U32}

