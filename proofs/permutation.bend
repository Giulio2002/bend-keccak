# Pairs (even, odd); mx complements both halves when m holds.
def il(+x: T.Lane) -> U32 & U32:
  (I.even(x),I.odd(x))

def mx(p: U32 & U32, m: Bool) -> U32 & U32:
  match p m:
    case Tuple{e,o} False{}: (e,o)
    case Tuple{e,o} True{}: (U32.not(e),U32.not(o))

def pxor(p: U32 & U32, q: U32 & U32) -> U32 & U32:
  match p q:
    case Tuple{pe,po} Tuple{qe,qo}: (U32.xor(pe,qe),U32.xor(po,qo))

# Whether lane n is held complemented.
def cm(n: Nat) -> Bool:
  match n:
    case 1n: True{}
    case 2n: True{}
    case 8n: True{}
    case 12n: True{}
    case 17n: True{}
    case 20n: True{}
    case _: False{}

