law rounds_correct:
  for +n: Nat
  for +i: Nat
  for +s: T.State
  {P.rounds(n,i,s) == S.rounds(n,i,s) : T.State}

def rounds_correct(n,i,s):
  Equal.trans(T.State,L.leave(P.steps(n,i,L.enter(s))),L.leave(P.steps(n,i,I.interleave(s))),F.rounds(n,i,s),
    Equal.cong(T.St,T.State,t => L.leave(P.steps(n,i,t)),L.enter(s),I.interleave(s),enter_il(s)),
    Equal.trans(T.State,L.leave(P.steps(n,i,I.interleave(s))),L.leave(I.interleave(F.rounds(n,i,s))),F.rounds(n,i,s),
      Equal.cong(T.St,T.State,t => L.leave(t),P.steps(n,i,I.interleave(s)),I.interleave(F.rounds(n,i,s)),steps_spec(n,i,s)),
      leave_il(F.rounds(n,i,s))))
