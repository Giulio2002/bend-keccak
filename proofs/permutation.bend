  match x:
    case U32{WCon{x0,WCon{x1,WCon{x2,WCon{x3,WCon{x4,WCon{x5,WCon{x6,WCon{x7,WCon{x8,WCon{x9,WCon{x10,WCon{x11,WCon{x12,WCon{x13,WCon{x14,WCon{x15,WCon{x16,WCon{x17,WCon{x18,WCon{x19,WCon{x20,WCon{x21,WCon{x22,WCon{x23,WCon{x24,WCon{x25,WCon{x26,WCon{x27,WCon{x28,WCon{x29,WCon{x30,WCon{x31,WNil{}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}:
      X.ext32(U32.or(U32.or(pbyte0(x),pbyte1(x)),U32.or(pbyte2(x),pbyte3(x))),punz(x),bit17(x0),bit17(x2),bit17(x4),bit17(x6),bit3(x8),bit3(x10),bit3(x12),bit3(x14),bit3(x16),bit3(x18),bit3(x20),bit3(x22),{==},{==},{==},{==},bit17(x1),bit17(x3),bit17(x5),bit17(x7),bit3(x9),bit3(x11),bit3(x13),bit3(x15),bit3(x17),bit3(x19),bit3(x21),bit3(x23),{==},{==},{==},{==})

law unz_perm:
  for +x: U32
  {L.unz(x) == punz(x) : U32}

def unz_perm(x):
  Equal.trans(U32,U32.or(U32.or(L.ub0(U32.to_nat(U32.and(255,x))),L.ub1(U32.to_nat(U32.and(255,U32.shrn(x,8n))))),U32.or(L.ub2(U32.to_nat(U32.and(255,U32.shrn(x,16n)))),L.ub3(U32.to_nat(U32.shrn(x,24n))))),U32.or(U32.or(pbyte0(x),pbyte1(x)),U32.or(pbyte2(x),pbyte3(x))),punz(x),
    or4_cong(L.ub0(U32.to_nat(U32.and(255,x))),pbyte0(x),L.ub1(U32.to_nat(U32.and(255,U32.shrn(x,8n)))),pbyte1(x),L.ub2(U32.to_nat(U32.and(255,U32.shrn(x,16n)))),pbyte2(x),L.ub3(U32.to_nat(U32.shrn(x,24n))),pbyte3(x),byte0_perm(x),byte1_perm(x),byte2_perm(x),byte3_perm(x)),
    punz_parts(x))

