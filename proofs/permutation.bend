  Equal.trans(U32 & U32,pxor(vchi0(fv(I.interleave(s),I.even(rc),I.odd(rc),b0()),fv(I.interleave(s),I.even(rc),I.odd(rc),b1()),fv(I.interleave(s),I.even(rc),I.odd(rc),b2())),(I.even(rc),I.odd(rc))),pxor(il(F.chi(sv(s,rc,b0()),sv(s,rc,b1()),sv(s,rc,b2()))),il(rc)),il(F.xor(F.chi(sv(s,rc,b0()),sv(s,rc,b1()),sv(s,rc,b2())),rc)),
