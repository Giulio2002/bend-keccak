law pair_eq:
  for -a: U32
  for -b: U32
  for -c: U32
  for -d: U32
  for e1: {a == c : U32}
  for e2: {b == d : U32}
  {(a,b) == (c,d) : U32 & U32}

def pair_eq(a,b,c,d,e1,e2):
  %e1 : {(a,b) == (_,d) : U32 & U32}
  %e2 : {(a,b) == (a,_) : U32 & U32}
  {==}

law pxor_cong:
  for -x0: U32 & U32
  for -y0: U32 & U32
  for -x1: U32 & U32
  for -y1: U32 & U32
  for e0: {x0 == y0 : U32 & U32}
  for e1: {x1 == y1 : U32 & U32}
  {pxor(x0,x1) == pxor(y0,y1) : U32 & U32}

def pxor_cong(x0,y0,x1,y1,e0,e1):
  %e0 : {pxor(x0,x1) == pxor(_,y1) : U32 & U32}
  %e1 : {pxor(x0,x1) == pxor(x0,_) : U32 & U32}
  {==}

law vchi0_cong:
  for -x0: U32 & U32
  for -y0: U32 & U32
  for -x1: U32 & U32
  for -y1: U32 & U32
  for -x2: U32 & U32
  for -y2: U32 & U32
  for e0: {x0 == y0 : U32 & U32}
  for e1: {x1 == y1 : U32 & U32}
