law ex_il:
  for +s: T.State
  for +rc: T.Lane
  for e: Ex
  {fv(I.interleave(s),I.even(rc),I.odd(rc),e) == mx(il(sv(s,rc,e)),mk(e)) : U32 & U32}

def ex_il(s,rc,e):
  match e:
    case V{n}: var_il(s,n)
    case C{}: {==}
    case X{+a,+b}:
      Equal.trans(U32 & U32,
        pxor(fv(I.interleave(s),I.even(rc),I.odd(rc),a),fv(I.interleave(s),I.even(rc),I.odd(rc),b)),
        pxor(mx(il(sv(s,rc,a)),mk(a)),mx(il(sv(s,rc,b)),mk(b))),
        mx(il(F.xor(sv(s,rc,a),sv(s,rc,b))),Bool.xor(mk(a),mk(b))),
        pxor_cong(fv(I.interleave(s),I.even(rc),I.odd(rc),a),mx(il(sv(s,rc,a)),mk(a)),fv(I.interleave(s),I.even(rc),I.odd(rc),b),mx(il(sv(s,rc,b)),mk(b)),ex_il(s,rc,a),ex_il(s,rc,b)),
        xor_il(sv(s,rc,a),sv(s,rc,b),mk(a),mk(b)))
    case R{+n,+a}:
      Equal.trans(U32 & U32,
        irot(n,fv(I.interleave(s),I.even(rc),I.odd(rc),a)),
        irot(n,mx(il(sv(s,rc,a)),mk(a))),
        mx(il(rol(n,sv(s,rc,a))),mk(a)),
        irot_cong(n,fv(I.interleave(s),I.even(rc),I.odd(rc),a),mx(il(sv(s,rc,a)),mk(a)),ex_il(s,rc,a)),
        rot_il(n,sv(s,rc,a),mk(a)))

