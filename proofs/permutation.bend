def fv(+t: T.St, +rce: U32, +rco: U32, e: Ex) -> U32 & U32:
  match e:
    case V{n}: ge(t,n)
    case C{}: (rce,rco)
    case X{a,b}: pxor(fv(t,rce,rco,a),fv(t,rce,rco,b))
    case R{n,a}: irot(n,fv(t,rce,rco,a))

def mk(e: Ex) -> Bool:
  match e:
    case V{n}: cm(n)
    case C{}: False{}
    case X{a,b}: Bool.xor(mk(a),mk(b))
    case R{n,a}: mk(a)

def vchi0(p: U32 & U32, q: U32 & U32, r: U32 & U32) -> U32 & U32:
  match p q r:
    case Tuple{pe,po} Tuple{qe,qo} Tuple{re,ro}:
      (U32.xor(pe,U32.or(qe,re)),U32.xor(po,U32.or(qo,ro)))

