law step_il:
  for +i: Nat
  for +s: T.State
  {P.round(I.interleave(s),P.rce(i),P.rco(i)) == I.interleave(F.round(s,F.constant(i))) : T.St}

def step_il(i,s):
  %Equal.sym(U32,P.rce(i),I.even(F.constant(i)),rce_il(i)) : {P.round(I.interleave(s),_,P.rco(i)) == I.interleave(F.round(s,F.constant(i))) : T.St}
  %Equal.sym(U32,P.rco(i),I.odd(F.constant(i)),rco_il(i)) : {P.round(I.interleave(s),I.even(F.constant(i)),_) == I.interleave(F.round(s,F.constant(i))) : T.St}
  round_il(s,F.constant(i))

law steps_pair:
  for +n: Nat
