import Base

# Bit n of a word, least significant first.
def wbit(m: Nat, n: Nat, w: Word(m)) -> Bool:
  match m n w:
    case 0n _ _: False{}
    case 1n+p 0n WCon{h,t}: h
    case 1n+p 1n+k WCon{h,t}: wbit(p,k,t)

def bit(n: Nat, x: U32) -> Bool:
  match x:
    case U32{w}: wbit(32n,n,w)

# Two words with equal bits are equal.
law ext32:
  for x: U32
  for y: U32
  for e0: {bit(0n,x) == bit(0n,y) : Bool}
  for e1: {bit(1n,x) == bit(1n,y) : Bool}
  for e2: {bit(2n,x) == bit(2n,y) : Bool}
  for e3: {bit(3n,x) == bit(3n,y) : Bool}
  for e4: {bit(4n,x) == bit(4n,y) : Bool}
  for e5: {bit(5n,x) == bit(5n,y) : Bool}
  for e6: {bit(6n,x) == bit(6n,y) : Bool}
  for e7: {bit(7n,x) == bit(7n,y) : Bool}
  for e8: {bit(8n,x) == bit(8n,y) : Bool}
  for e9: {bit(9n,x) == bit(9n,y) : Bool}
  for e10: {bit(10n,x) == bit(10n,y) : Bool}
  for e11: {bit(11n,x) == bit(11n,y) : Bool}
  for e12: {bit(12n,x) == bit(12n,y) : Bool}
  for e13: {bit(13n,x) == bit(13n,y) : Bool}
  for e14: {bit(14n,x) == bit(14n,y) : Bool}
  for e15: {bit(15n,x) == bit(15n,y) : Bool}
  for e16: {bit(16n,x) == bit(16n,y) : Bool}
  for e17: {bit(17n,x) == bit(17n,y) : Bool}
  for e18: {bit(18n,x) == bit(18n,y) : Bool}
  for e19: {bit(19n,x) == bit(19n,y) : Bool}
  for e20: {bit(20n,x) == bit(20n,y) : Bool}
  for e21: {bit(21n,x) == bit(21n,y) : Bool}
  for e22: {bit(22n,x) == bit(22n,y) : Bool}
  for e23: {bit(23n,x) == bit(23n,y) : Bool}
  for e24: {bit(24n,x) == bit(24n,y) : Bool}
  for e25: {bit(25n,x) == bit(25n,y) : Bool}
  for e26: {bit(26n,x) == bit(26n,y) : Bool}
  for e27: {bit(27n,x) == bit(27n,y) : Bool}
  for e28: {bit(28n,x) == bit(28n,y) : Bool}
  for e29: {bit(29n,x) == bit(29n,y) : Bool}
  for e30: {bit(30n,x) == bit(30n,y) : Bool}
  for e31: {bit(31n,x) == bit(31n,y) : Bool}
  {x == y : U32}

